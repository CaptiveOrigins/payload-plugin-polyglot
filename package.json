{
  "name": "@captiveorigins/payload-plugin-polyglot",
  "version": "0.2.0",
  "description": "Translation for Payload: keeps content in every language, a little at a time, translating on publish and in a sweep, remembering every sentence, and never overwriting a human-reviewed translation.",
  "homepage": "https://github.com/CaptiveOrigins/payload-plugin-polyglot#readme",
  "bugs": {
    "url": "https://github.com/CaptiveOrigins/payload-plugin-polyglot/issues"
  },
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "i18n",
    "localization",
    "translation",
    "machine-translation",
    "claude"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaptiveOrigins/payload-plugin-polyglot.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./claude": {
      "types": "./dist/claude.d.ts",
      "import": "./dist/claude.js"
    },
    "./rsc": {
      "types": "./dist/rsc/index.d.ts",
      "import": "./dist/rsc/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=1.0.0",
    "@payloadcms/next": "^3.80.0",
    "@payloadcms/ui": "^3.80.0",
    "next": ">=15",
    "payload": "^3.80.0",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@payloadcms/db-mongodb": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "graphql": "^16.14.2",
    "mongodb-memory-server": "^11.3.0",
    "next": "16.3.3",
    "payload": "3.92.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
